# Forge configuration — copy to .env and fill in.
#
# This file contains PLACEHOLDERS ONLY. It is committed; .env is not.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --------------------------------------------------------------------- core
# development | test | staging | production
FORGE_ENVIRONMENT=development

# REQUIRED outside development. Minimum 32 characters. No default exists.
FORGE_SECRET_KEY=

# --------------------------------------------------------------- datastores
# REQUIRED outside development. In development, leave empty to use the embedded
# PostgreSQL server managed by scripts/run_stack.sh.
FORGE_DATABASE_URL=
# Example: postgresql+asyncpg://forge:CHANGE_ME@localhost:5432/forge

# Optional. Without it, rate limiting falls back to per-process counters, which
# are weaker across multiple API replicas. The /ready endpoint reports which
# backend is active.
FORGE_REDIS_URL=redis://127.0.0.1:6399/0

# ----------------------------------------------------------------- security
# Webhook ingestion is DISABLED until this is set. Unsigned deliveries are never
# accepted. Use the same value in the GitHub webhook configuration.
FORGE_GITHUB_WEBHOOK_SECRET=

# Comma-separated. A wildcard is refused outside development.
FORGE_CORS_ALLOW_ORIGINS=http://localhost:5173

# Development-only bootstrap administrator. Both must be set for it to apply, and
# Settings refuses them outside development. There is no built-in default password.
FORGE_BOOTSTRAP_ADMIN_EMAIL=
FORGE_BOOTSTRAP_ADMIN_PASSWORD=

FORGE_ACCESS_TOKEN_TTL_SECONDS=3600
FORGE_RATE_LIMIT_ENABLED=true
FORGE_RATE_LIMIT_LOGIN_PER_MINUTE=10

# -------------------------------------------------------------------- build
# process  — runs builds as local processes with resource limits. NOT a kernel
#            sandbox; see docs/security.md.
# buildkit — builds container images via an isolated BuildKit daemon.
FORGE_BUILDER=process

# The process builder must be enabled deliberately, so its weaker isolation can
# never be entered by accident.
FORGE_ALLOW_UNSANDBOXED_BUILDS=false

# Directories exposed on the build PATH so manifest-declared tools resolve.
# Empty means the running interpreter's own bin directory.
FORGE_BUILD_TOOLCHAIN_PATH=

FORGE_BUILD_TIMEOUT_SECONDS=900
FORGE_BUILD_MEMORY_LIMIT_MB=2048

# ----------------------------------------------------------------- registry
# local | ecr
FORGE_REGISTRY=local
# Required when FORGE_REGISTRY=ecr:
# FORGE_ECR_REGISTRY=000000000000.dkr.ecr.eu-west-1.amazonaws.com
# AWS_REGION=eu-west-1

# ----------------------------------------------------------------- delivery
# process | docker
FORGE_DEPLOY_ADAPTER=process
FORGE_ROUTER_ADMIN_URL=http://127.0.0.1:8099
FORGE_ROUTER_PUBLIC_HOST=127.0.0.1

# Must be ascending and finish at 100.
FORGE_CANARY_STEPS=10,25,50,100
FORGE_CANARY_STEP_SECONDS=20

# Health gates. A candidate is promoted only on an explicit HEALTHY verdict;
# below health_min_samples the verdict is UNKNOWN, which never promotes.
FORGE_HEALTH_MIN_SAMPLES=20
FORGE_HEALTH_MAX_ERROR_RATE=0.05
FORGE_HEALTH_MAX_P95_LATENCY_MS=750

# ------------------------------------------------------------ observability
FORGE_LOG_LEVEL=INFO
# json | console
FORGE_LOG_FORMAT=json
FORGE_METRICS_ENABLED=true
FORGE_OTEL_ENABLED=false
FORGE_OTEL_ENDPOINT=

# ----------------------------------------------------- container stack only
# Used by infra/compose/docker-compose.yml.
POSTGRES_PASSWORD=
VITE_API_BASE=http://localhost:8000
